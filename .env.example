# DriveEasy - every setting the app reads. Copy to .env.local and fill in.
# No real values here. This file is safe to commit.

# --- App ---
APP_URL=http://localhost:3000

# --- Database ---
# Local:  postgres://driveeasy:<password>@localhost:5434/driveeasy_dev
# Cloud:  the connection string from your hosted PostgreSQL provider
#         (Neon via Vercel Marketplace: use the POOLED url for the app)
DATABASE_URL=
# Direct (unpooled) connection used only by `pnpm db:migrate:deploy`
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info

# --- Authentication (Better Auth, email + password) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Payments ---
# fake   = local test provider (no network, no account)
# stripe = Stripe in TEST mode (written, not yet verified against Stripe)
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_WEBHOOK_SECRET=
FAKE_PAYMENT_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
# Set to true to deliver every webhook twice (tests duplicate handling)
FAKE_PAYMENT_DUPLICATE_WEBHOOKS=false
# Future cloud values (used when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- File storage ---
# local = private folder on disk (outside /public)
# vercel-blob = Vercel Blob, private access (written, not yet verified)
STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=./storage/uploads
# Future cloud values (used when STORAGE_DRIVER=vercel-blob)
BLOB_READ_WRITE_TOKEN=
BLOB_PATH_PREFIX=

# --- Scheduled jobs ---
# local = run `pnpm jobs:release-holds` (or `pnpm jobs:watch`) on this machine
# cron  = a cloud scheduler calls GET /api/cron/release-holds with
#         header "Authorization: Bearer <CRON_SECRET>"
SCHEDULER_DRIVER=local
CRON_SECRET=
